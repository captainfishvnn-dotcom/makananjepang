  font-size: 16px;
}

body {
  font-family: var(--font-body);
  background-color: var(--bg-main);
  color: var(--text-primary);
  line-height: 1.65;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}

img {
  max-width: 100%;
  height: auto;
  display: block;
}

a {
  text-decoration: none;
  color: inherit;
  transition: var(--transition-fast);
}

ul {
  list-style: none;
}

button, input, select, textarea {
  font-family: inherit;
  font-size: inherit;
}

/* --- Utility Container --- */
.container {
  width: 100%;
  max-width: 1200px;
  margin-left: auto;
  margin-right: auto;
  padding-left: 1.5rem;
  padding-right: 1.5rem;
}

.section-padding {
  padding-top: 5.5rem;
  padding-bottom: 5.5rem;
}

/* --- Section Headers --- */
.section-header {
  text-align: center;
  max-width: 680px;
  margin: 0 auto 3.5rem auto;
}

.section-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  background-color: var(--primary-light);
  color: var(--primary-color);
  font-size: 0.85rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  padding: 0.4rem 1.1rem;
  border-radius: var(--radius-full);
  margin-bottom: 1rem;
  border: 1px solid rgba(217, 72, 15, 0.2);
}

.section-title {
  font-family: var(--font-heading);
  font-size: 2.4rem;
  font-weight: 800;
  color: var(--dark-color);
  line-height: 1.25;
  margin-bottom: 1rem;
}

.section-subtitle {
  font-size: 1.05rem;
  color: var(--text-secondary);
}

/* --- Buttons & Hover Effects --- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.6rem;
  padding: 0.85rem 1.8rem;
  font-weight: 600;
  font-size: 0.95rem;
  border-radius: var(--radius-full);
  cursor: pointer;
  border: 2px solid transparent;
  transition: var(--transition-normal);
  text-align: center;
}

.btn-primary {
  background: linear-gradient(135deg, var(--primary-color), #f76707);
  color: #ffffff;
  box-shadow: 0 6px 18px rgba(217, 72, 15, 0.35);
}

.btn-primary:hover {
  background: linear-gradient(135deg, var(--primary-hover), var(--primary-color));
  transform: translateY(-3px);
  box-shadow: 0 10px 24px rgba(217, 72, 15, 0.45);
  color: #ffffff;
}

.btn-secondary {
  background-color: transparent;
  color: var(--dark-color);
  border-color: var(--border-color);
}

.btn-secondary:hover {
  border-color: var(--primary-color);
  color: var(--primary-color);
  background-color: var(--primary-light);
  transform: translateY(-3px);
}

.btn-whatsapp {
  background-color: #25d366;
  color: #ffffff;
}

.btn-whatsapp:hover {
  background-color: #1ebd56;
  transform: translateY(-3px);
  box-shadow: 0 8px 20px rgba(37, 211, 102, 0.35);
  color: #ffffff;
}

.btn-sm {
  padding: 0.55rem 1.1rem;
  font-size: 0.85rem;
}

.btn:active {
  transform: translateY(-1px);
}

/* ==========================================================================
   1. NAVBAR / HEADER
   ========================================================================== */
.site-header {
  position: sticky;
  top: 0;
  z-index: 1000;
  background-color: rgba(255, 253, 249, 0.92);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(236, 220, 203, 0.7);
  transition: var(--transition-normal);
}

.site-header.scrolled {
  box-shadow: var(--shadow-sm);
  background-color: rgba(255, 253, 249, 0.98);
}

.navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 80px;
}

/* Brand Logo */
.brand-logo {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.brand-icon {
  width: 44px;
  height: 44px;
  background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
  font-size: 1.3rem;
  box-shadow: 0 4px 12px rgba(217, 72, 15, 0.25);
}

.brand-text-wrap {
  display: flex;
  flex-direction: column;
}

.brand-name {
  font-family: var(--font-heading);
  font-size: 1.3rem;
  font-weight: 800;
  color: var(--dark-color);
  line-height: 1.1;
  letter-spacing: -0.02em;
}

.brand-tagline {
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--primary-color);
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

/* Navigation Menu */
.nav-menu {
  display: flex;
  align-items: center;
  gap: 2rem;
}

.nav-link {
  font-weight: 600;
  font-size: 0.95rem;
  color: var(--text-primary);
  position: relative;
  padding: 0.4rem 0;
}

.nav-link::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 0%;
  height: 2px;
  background-color: var(--primary-color);
  transition: width 0.3s ease;
  border-radius: 2px;
}

.nav-link:hover {
  color: var(--primary-color);
}

.nav-link:hover::after,
.nav-link.active::after {
  width: 100%;
}

.nav-link.active {
  color: var(--primary-color);
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 1rem;
}

/* Mobile Toggle */
.mobile-toggle {
  display: none;
  background: none;
  border: none;
  cursor: pointer;
  color: var(--dark-color);
  font-size: 1.5rem;
  padding: 0.5rem;
}

/* ==========================================================================
   2. HERO SECTION
   ========================================================================== */
.hero-section {
  position: relative;
  padding: 4rem 0 5rem 0;
  background: linear-gradient(180deg, var(--bg-main) 0%, var(--bg-alt) 100%);
  overflow: hidden;
}

.hero-grid {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 3.5rem;
}

.hero-content {
  flex: 1;
  max-width: 580px;
}

.hero-pill {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  background-color: #fff;
  border: 1px solid var(--border-color);
  padding: 0.45rem 1.1rem;
  border-radius: var(--radius-full);
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--dark-color);
  box-shadow: var(--shadow-sm);
  margin-bottom: 1.5rem;
}

.hero-pill .dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background-color: var(--accent-green);
  display: inline-block;
  box-shadow: 0 0 0 3px rgba(43, 138, 62, 0.2);
}

.hero-title {
  font-size: 3.2rem;
  font-weight: 800;
  line-height: 1.15;
  color: var(--dark-color);
  margin-bottom: 1.25rem;
  letter-spacing: -0.02em;
}

.hero-title .highlight {
  color: var(--primary-color);
  position: relative;
  display: inline-block;
}

.hero-title .highlight::after {
  content: '';
  position: absolute;
  bottom: 6px;
  left: 0;
  width: 100%;
  height: 10px;
  background-color: rgba(245, 159, 0, 0.25);
  z-index: -1;
  border-radius: 4px;
}

.hero-description {
  font-size: 1.15rem;
  color: var(--text-secondary);
  margin-bottom: 2.2rem;
  line-height: 1.7;
}

.hero-cta-group {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 1.2rem;
  margin-bottom: 2.8rem;
}

.hero-badges-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 1.5rem;
  padding-top: 1.5rem;
  border-top: 1px solid var(--border-color);
}

.hero-feature-item {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--dark-muted);
}

.hero-feature-item i {
  color: var(--primary-color);
  font-size: 1.1rem;
}

/* Hero Visual / Image */
.hero-visual {
  flex: 1;
  position: relative;
  display: flex;
  justify-content: center;
}

.hero-image-wrapper {
  position: relative;
  width: 100%;
  max-width: 500px;
  border-radius: 28px;
  overflow: hidden;
  box-shadow: var(--shadow-lg);
  border: 6px solid #ffffff;
}

.hero-image-wrapper img {
  width: 100%;
  height: 480px;
  object-fit: cover;
  transition: transform 0.6s ease;
}

.hero-image-wrapper:hover img {
  transform: scale(1.04);
}

/* Floating Badges */
.floating-badge {
  position: absolute;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(8px);
  padding: 0.8rem 1.2rem;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-md);
  display: flex;
  align-items: center;
  gap: 0.8rem;
  z-index: 10;
  border: 1px solid rgba(255, 255, 255, 0.8);
}

.badge-top-left {
  top: 24px;
  left: -20px;
  animation: floatSlow 4s ease-in-out infinite;
}

.badge-bottom-right {
  bottom: 24px;
  right: -20px;
  animation: floatSlow 4s ease-in-out infinite reverse;
}

.floating-icon {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  background-color: var(--primary-light);
  color: var(--primary-color);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.2rem;
}

.floating-text strong {
  display: block;
  font-size: 0.9rem;
  color: var(--dark-color);
}

.floating-text span {
  font-size: 0.75rem;
  color: var(--text-secondary);
}

@keyframes floatSlow {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8px); }
}

/* ==========================================================================
   3. TENTANG KAMI SECTION
   ========================================================================== */
.about-section {
  background-color: #ffffff;
  position: relative;
}

.about-grid {
  display: flex;
  align-items: center;
  gap: 4rem;
}

.about-image-col {
  flex: 1;
  position: relative;
}

.about-image-card {
  position: relative;
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-lg);
}

.about-image-card img {
  width: 100%;
  height: 440px;
  object-fit: cover;
}

.experience-tag {
  position: absolute;
  bottom: 20px;
  right: 20px;
  background: var(--dark-color);
  color: #fff;
  padding: 1.2rem 1.6rem;
  border-radius: var(--radius-md);
  text-align: center;
  box-shadow: var(--shadow-md);
  border: 2px solid var(--secondary-color);
}

.experience-tag .exp-number {
  font-size: 2rem;
  font-weight: 800;
  color: var(--secondary-color);
  line-height: 1;
}

.experience-tag .exp-text {
  font-size: 0.8rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.about-content-col {
  flex: 1.2;
}

.about-lead {
  font-size: 1.15rem;
  font-weight: 600;
  color: var(--primary-color);
  margin-bottom: 1rem;
}

.about-text {
  color: var(--text-secondary);
  margin-bottom: 1.5rem;
}

/* Feature Pillars List */
.about-pillars {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.2rem;
  margin-top: 1.8rem;
  margin-bottom: 2rem;
}

.pillar-item {
  display: flex;
  align-items: flex-start;
  gap: 0.8rem;
}

.pillar-icon {
  width: 36px;
  height: 36px;
  border-radius: 8px;
  background-color: var(--primary-light);
  color: var(--primary-color);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1rem;
  flex-shrink: 0;
}

.pillar-item h4 {
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--dark-color);
  margin-bottom: 0.2rem;
}

.pillar-item p {
  font-size: 0.85rem;
  color: var(--text-secondary);
  line-height: 1.4;
}

/* Stats Counter Row */
.stats-banner {
  background-color: var(--bg-alt);
  border-radius: var(--radius-lg);
  padding: 2.5rem 1.5rem;
  margin-top: 3.5rem;
  border: 1px solid var(--border-color);
}

.stats-grid {
  display: flex;
  justify-content: space-around;
  flex-wrap: wrap;
  gap: 2rem;
  text-align: center;
}

.stat-item {
  flex: 1;
  min-width: 140px;
}

.stat-number {
  font-size: 2.2rem;
  font-weight: 800;
  color: var(--primary-color);
  line-height: 1.1;
  margin-bottom: 0.3rem;
}

.stat-label {
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--text-secondary);
}

/* ==========================================================================
   4. MENU SPESIAL SECTION (GRID & CARDS)
   ========================================================================== */
.menu-section {
  background-color: var(--bg-alt);
}

/* Menu Category Tabs */
.menu-filter-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.8rem;
  margin-bottom: 3rem;
  flex-wrap: wrap;
}

.filter-btn {
  padding: 0.6rem 1.4rem;
  border-radius: var(--radius-full);
  background-color: #ffffff;
  color: var(--text-primary);
  border: 1px solid var(--border-color);
  font-weight: 600;
  font-size: 0.9rem;
  cursor: pointer;
  transition: var(--transition-fast);
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
}

.filter-btn:hover {
  border-color: var(--primary-color);
  color: var(--primary-color);
  background-color: var(--primary-light);
}

.filter-btn.active {
  background-color: var(--primary-color);
  color: #ffffff;
  border-color: var(--primary-color);
  box-shadow: 0 4px 12px rgba(217, 72, 15, 0.3);
}

/* CSS Grid for Product Cards */
.menu-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
  gap: 2rem;
}

/* Product Card */
.menu-card {
  background-color: var(--bg-card);
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  border: 1px solid var(--border-color);
  display: flex;
  flex-direction: column;
  transition: var(--transition-normal);
  position: relative;
}

.menu-card:hover {
  transform: translateY(-8px);
  box-shadow: var(--shadow-hover);
  border-color: rgba(217, 72, 15, 0.3);
}

/* Card Image Box */
.card-media {
  position: relative;
  width: 100%;
  height: 210px;
  overflow: hidden;
  background-color: #e9ecef;
}

.card-media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.menu-card:hover .card-media img {
  transform: scale(1.08);
}

/* Badges on Card Image */
.card-badge-top {
  position: absolute;
  top: 12px;
  left: 12px;
  display: flex;
  gap: 0.4rem;
  z-index: 2;
}

.badge-tag {
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  padding: 0.25rem 0.65rem;
  border-radius: var(--radius-full);
}

.badge-category {
  background-color: rgba(31, 20, 14, 0.85);
  color: #ffffff;
  backdrop-filter: blur(4px);
}

.badge-bestseller {
  background-color: var(--primary-color);
  color: #ffffff;
}

.badge-special {
  background-color: var(--secondary-color);
  color: var(--dark-color);
}

/* Rating Pill */
.card-rating {
  position: absolute;
  bottom: 12px;
  right: 12px;
  background-color: rgba(255, 255, 255, 0.95);
  padding: 0.2rem 0.6rem;
  border-radius: var(--radius-full);
  font-size: 0.8rem;
  font-weight: 700;
  color: var(--dark-color);
  display: flex;
  align-items: center;
  gap: 0.25rem;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
}

.card-rating i {
  color: #f59f00;
}

/* Card Body */
.card-body {
  padding: 1.4rem;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.product-title {
  font-size: 1.18rem;
  font-weight: 700;
  color: var(--dark-color);
  margin-bottom: 0.5rem;
  line-height: 1.35;
  transition: color 0.2s ease;
}

.menu-card:hover .product-title {
  color: var(--primary-color);
}

.product-desc {
  font-size: 0.88rem;
  color: var(--text-secondary);
  line-height: 1.5;
  margin-bottom: 1.2rem;
  flex: 1;
}

/* Card Footer (Price & Action) */
.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 1rem;
  border-top: 1px dashed var(--border-color);
}

.price-wrap {
  display: flex;
  flex-direction: column;
}

.price-label {
  font-size: 0.72rem;
  color: var(--text-light);
  text-transform: uppercase;
  font-weight: 600;
}

.product-price {
  font-size: 1.25rem;
  font-weight: 800;
  color: var(--primary-color);
}

.btn-order-item {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background-color: var(--primary-light);
  color: var(--primary-color);
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  cursor: pointer;
  font-size: 1.05rem;
  transition: var(--transition-normal);
}

.btn-order-item:hover {
  background-color: var(--primary-color);
  color: #ffffff;
  transform: rotate(90deg) scale(1.1);
  box-shadow: 0 4px 12px rgba(217, 72, 15, 0.35);
}

/* ==========================================================================
   5. KEUNGGULAN / FEATURES
   ========================================================================== */
.features-section {
  background-color: #ffffff;
}

.features-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 2rem;
}

.feature-box {
  background-color: var(--bg-main);
  padding: 2.2rem 1.8rem;
  border-radius: var(--radius-md);
  border: 1px solid var(--border-color);
  text-align: center;
  transition: var(--transition-normal);
}

.feature-box:hover {
  transform: translateY(-6px);
  border-color: var(--primary-color);
  box-shadow: var(--shadow-md);
  background-color: #ffffff;
}

.feature-icon-circle {
  width: 68px;
  height: 68px;
  margin: 0 auto 1.4rem auto;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary-light), #fff);
  border: 2px solid rgba(217, 72, 15, 0.2);
  color: var(--primary-color);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.6rem;
  transition: var(--transition-normal);
}

.feature-box:hover .feature-icon-circle {
  background: var(--primary-color);
  color: #ffffff;
  transform: scale(1.1);
}

.feature-title {
  font-size: 1.15rem;
  font-weight: 700;
  color: var(--dark-color);
  margin-bottom: 0.6rem;
}

.feature-text {
  font-size: 0.9rem;
  color: var(--text-secondary);
  line-height: 1.55;
}

/* ==========================================================================
   6. KONTAK & RESERVASI SECTION
   ========================================================================== */
.contact-section {
  background-color: var(--bg-alt);
}

.contact-layout {
  display: grid;
  grid-template-columns: 1fr 1.3fr;
  gap: 3.5rem;
  align-items: start;
}

/* Contact Info Column */
.contact-info-col {
  display: flex;
  flex-direction: column;
  gap: 1.8rem;
}

.contact-card {
  background-color: #ffffff;
  padding: 1.8rem;
  border-radius: var(--radius-md);
  border: 1px solid var(--border-color);
  box-shadow: var(--shadow-sm);
  display: flex;
  align-items: flex-start;
  gap: 1.2rem;
  transition: var(--transition-fast);
}

.contact-card:hover {
  border-color: var(--primary-color);
  transform: translateX(4px);
}

.contact-icon {
  width: 50px;
  height: 50px;
  border-radius: 12px;
  background-color: var(--primary-light);
  color: var(--primary-color);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.3rem;
  flex-shrink: 0;
}

.contact-details h4 {
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--dark-color);
  margin-bottom: 0.3rem;
}

.contact-details p {
  font-size: 0.92rem;
  color: var(--text-secondary);
  line-height: 1.5;
}

.contact-details a {
  color: var(--primary-color);
  font-weight: 600;
}

.contact-details a:hover {
  text-decoration: underline;
}

/* Social links in contact */
.social-links {
  display: flex;
  gap: 0.8rem;
  margin-top: 0.5rem;
}

.social-btn {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background-color: #ffffff;
  border: 1px solid var(--border-color);
  color: var(--dark-color);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.1rem;
  transition: var(--transition-normal);
}

.social-btn:hover {
  background-color: var(--primary-color);
  color: #ffffff;
  border-color: var(--primary-color);
  transform: translateY(-3px);
  box-shadow: 0 4px 10px rgba(217, 72, 15, 0.3);
}

/* Contact Form Column */
.reservation-card {
  background-color: #ffffff;
  padding: 2.5rem;
  border-radius: var(--radius-lg);
  border: 1px solid var(--border-color);
  box-shadow: var(--shadow-md);
}

.reservation-card h3 {
  font-size: 1.5rem;
  font-weight: 800;
  color: var(--dark-color);
  margin-bottom: 0.5rem;
}

.reservation-card p {
  font-size: 0.92rem;
  color: var(--text-secondary);
  margin-bottom: 2rem;
}

/* Form Styling with Specific Selectors */
.form-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.2rem;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}

.form-group.full-width {
  grid-column: 1 / -1;
}

.form-label {
  font-size: 0.88rem;
  font-weight: 600;
  color: var(--dark-color);
}

/* Attribute Selectors for Inputs */
input[type="text"],
input[type="tel"],
input[type="date"],
input[type="time"],
select,
textarea {
  width: 100%;
  padding: 0.85rem 1.1rem;
  border: 1.5px solid var(--border-color);
  border-radius: var(--radius-sm);
  background-color: var(--bg-main);
  color: var(--text-primary);
  font-size: 0.95rem;
  transition: var(--transition-fast);
  outline: none;
}

input[type="text"]:focus,
input[type="tel"]:focus,
input[type="date"]:focus,
input[type="time"]:focus,
select:focus,
textarea:focus {
  border-color: var(--border-focus);
  background-color: #ffffff;
  box-shadow: 0 0 0 3px rgba(217, 72, 15, 0.15);
}

textarea {
  resize: vertical;
  min-height: 100px;
}

.form-submit-btn {
  width: 100%;
  margin-top: 1rem;
  padding: 1rem;
  font-size: 1rem;
}

/* ==========================================================================
   7. FOOTER
   ========================================================================== */
.footer {
  background-color: var(--dark-color);
  color: #d6cbbf;
  padding-top: 4.5rem;
  padding-bottom: 2rem;
  border-top: 4px solid var(--primary-color);
}

.footer-grid {
  display: grid;
  grid-template-columns: 1.6fr 1fr 1fr 1.2fr;
  gap: 3rem;
  margin-bottom: 3.5rem;
}

/* Descendant Selectors for Footer Columns */
.footer-col h4 {
  font-size: 1.15rem;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 1.4rem;
  position: relative;
  padding-bottom: 0.6rem;
}

.footer-col h4::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 36px;
  height: 2px;
  background-color: var(--primary-color);
}

.footer-col p {
  font-size: 0.9rem;
  line-height: 1.6;
  margin-bottom: 1rem;
  color: #b5a498;
}

.footer-nav {
  display: flex;
  flex-direction: column;
  gap: 0.7rem;
}

.footer-nav a {
  font-size: 0.9rem;
  color: #c4b5a8;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  transition: var(--transition-fast);
}

.footer-nav a:hover {
  color: var(--secondary-color);
  transform: translateX(4px);
}

.footer-contact-list {
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
  font-size: 0.9rem;
}

.footer-contact-list li {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  color: #c4b5a8;
}

.footer-contact-list i {
  color: var(--primary-color);
  margin-top: 0.2rem;
}

.opening-hours-card {
  background-color: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  padding: 1.2rem;
  border-radius: var(--radius-sm);
}

.opening-hours-card .day {
  font-weight: 700;
  color: #ffffff;
  font-size: 0.9rem;
}

.opening-hours-card .time {
  color: var(--secondary-color);
  font-size: 0.85rem;
  font-weight: 600;
}

.footer-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 2rem;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  font-size: 0.85rem;
  color: #8c7c71;
  flex-wrap: wrap;
  gap: 1rem;
}

.footer-bottom a {
  color: #b5a498;
}

.footer-bottom a:hover {
  color: var(--secondary-color);
}

/* ==========================================================================
   8. MODAL & INTERACTIVE TOAST
   ========================================================================== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(31, 20, 14, 0.7);
  backdrop-filter: blur(4px);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
  padding: 1rem;
}

.modal-overlay.active {
  opacity: 1;
  visibility: visible;
}

.modal-content {
  background-color: #ffffff;
  width: 100%;
  max-width: 480px;
  border-radius: var(--radius-lg);
  padding: 2.2rem;
  box-shadow: var(--shadow-lg);
  transform: translateY(20px) scale(0.95);
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  position: relative;
}

.modal-overlay.active .modal-content {
  transform: translateY(0) scale(1);
}

.modal-close-btn {
  position: absolute;
  top: 1.2rem;
  right: 1.2rem;
  background: none;
  border: none;
  font-size: 1.3rem;
  color: var(--text-light);
  cursor: pointer;
  transition: color 0.2s;
}

.modal-close-btn:hover {
  color: var(--primary-color);
}

.modal-product-preview {
  display: flex;
  gap: 1rem;
  align-items: center;
  padding: 1rem;
  background-color: var(--bg-alt);
  border-radius: var(--radius-md);
  margin: 1.2rem 0;
}

.modal-product-img {
  width: 70px;
  height: 70px;
  border-radius: var(--radius-sm);
  object-fit: cover;
}

.modal-qty-control {
  display: flex;
  align-items: center;
  gap: 0.8rem;
  margin: 1.2rem 0;
}

.qty-btn {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: 1px solid var(--border-color);
  background: #fff;
  cursor: pointer;
  font-size: 1.1rem;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  transition: var(--transition-fast);
}

.qty-btn:hover {
  background: var(--primary-color);
  color: #fff;
  border-color: var(--primary-color);
}

.qty-input {
  width: 50px;
  text-align: center;
  font-weight: 700;
  padding: 0.4rem;
}

/* Toast Message */
.toast-msg {
  position: fixed;
  bottom: 24px;
  right: 24px;
  background: var(--dark-color);
  color: #ffffff;
  padding: 1rem 1.6rem;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-lg);
  display: flex;
  align-items: center;
  gap: 0.8rem;
  z-index: 3000;
  transform: translateY(100px);
  opacity: 0;
  transition: all 0.3s ease;
  border-left: 4px solid var(--primary-color);
}

.toast-msg.show {
  transform: translateY(0);
  opacity: 1;
}

/* ==========================================================================
   9. RESPONSIVE DESIGN (LAPTOP, TABLET & MOBILE)
   ========================================================================== */
/* Tablet & Small Laptops (max-width: 1024px) */
@media screen and (max-width: 1024px) {
  .hero-grid {
    gap: 2rem;
  }
  
  .hero-title {
    font-size: 2.6rem;
  }
  
  .about-grid {
    gap: 2.5rem;
  }

  .footer-grid {
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
  }
}

/* Tablet & Mobile Screens (max-width: 768px) */
@media screen and (max-width: 768px) {
  .section-padding {
    padding-top: 4rem;
    padding-bottom: 4rem;
  }

  .section-title {
    font-size: 2rem;
  }

  /* Mobile Navbar */
  .mobile-toggle {
    display: block;
  }

  .nav-menu {
    position: fixed;
    top: 80px;
    left: -100%;
    width: 100%;
    height: calc(100vh - 80px);
    background-color: #ffffff;
    flex-direction: column;
    align-items: flex-start;
    padding: 2.5rem 2rem;
    gap: 1.5rem;
    box-shadow: var(--shadow-md);
    transition: left 0.35s ease;
    overflow-y: auto;
  }

  .nav-menu.open {
    left: 0;
  }

  .nav-link {
    font-size: 1.15rem;
    width: 100%;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--border-color);
  }

  .nav-actions .btn-sm {
    display: none;
  }

  /* Hero Mobile */
  .hero-grid {
    flex-direction: column-reverse;
    text-align: center;
    gap: 3rem;
  }

  .hero-content {
    max-width: 100%;
  }

  .hero-title {
    font-size: 2.2rem;
  }

  .hero-cta-group {
    justify-content: center;
  }

  .hero-badges-row {
    justify-content: center;
  }

  .floating-badge {
    display: none; /* Hide floating badges on smaller screens for cleaner view */
  }

  .hero-image-wrapper {
    max-width: 380px;
    margin: 0 auto;
  }

  .hero-image-wrapper img {
    height: 320px;
  }

  /* About Section Mobile */
  .about-grid {
    flex-direction: column;
  }

  .about-pillars {
    grid-template-columns: 1fr;
  }

  .about-image-card img {
    height: 320px;
  }

  /* Contact Mobile */
  .contact-layout {
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  .form-grid {
    grid-template-columns: 1fr;
  }

  .footer-grid {
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .footer-bottom {
    flex-direction: column;
    text-align: center;
    gap: 0.6rem;
  }
}

/* Extra Small Mobile (max-width: 480px) */
@media screen and (max-width: 480px) {
  .hero-title {
    font-size: 1.85rem;
  }

  .btn {
    width: 100%;
  }

  .menu-grid {
    grid-template-columns: 1fr;
  }

  .reservation-card {
    padding: 1.6rem;
  }

  .stats-grid {
    gap: 1.2rem;
  }

  .stat-number {
    font-size: 1.8rem;
  }
}
